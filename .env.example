# Copia este archivo a /var/www/portfolio/.env en el VPS y llénalo.
# Nunca lo subas a git. Cualquier cambio aquí requiere reconstruir la imagen
# (./deploy.sh lo hace): las páginas se prerenderizan con estos valores.

# Dominio raíz, sin https:// ni diagonal final. Sus registros DNS (A de @ y
# CNAME de www) deben apuntar al VPS (76.13.106.210) ANTES del deploy, para que
# Let's Encrypt pueda emitir los certificados. carlogarza.dev ya apunta ahí
# (zona de Hostinger). www.DOMAIN y carlo.apicehq.com redirigen aquí.
DOMAIN=carlogarza.dev

# Analítica sin cookies (opcional). Llena UNA de las dos o ninguna.
#
# Umami — ya tienes una instancia propia en stats.apicehq.com: agrega el sitio
# en su panel y copia aquí el Website ID.
UMAMI_WEBSITE_ID=
UMAMI_SRC=https://stats.apicehq.com/script.js
#
# Plausible — PLAUSIBLE_SRC sólo si es self-hosted:
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=
