# Sólo para deploy/compose.caddy.yml (VPS sin Traefik).
# Caddy termina HTTPS (Let's Encrypt, renovación automática) y reenvía al
# contenedor de Next.js. DOMAIN llega desde .env.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy web:3000
}

# www y el dominio anterior → apex. Ambos necesitan su registro DNS hacia el
# VPS; si alguno falta, Caddy reintentaría sin fin su certificado.
www.{$DOMAIN}, carlo.apicehq.com {
	redir https://{$DOMAIN}{uri} permanent
}
